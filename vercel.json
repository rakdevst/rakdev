{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/endorser", "destination": "/endorser.html" },
    { "source": "/endorse", "destination": "/endorser.html" },
    { "source": "/endorser/(.*)", "destination": "/endorser.html" },
    { "source": "/endorse/(.*)", "destination": "/endorser.html" },
    { "source": "/resources", "destination": "/resources.html" },
    { "source": "/resource", "destination": "/resources.html" },
    { "source": "/resources/(.*)", "destination": "/resources.html" },
    { "source": "/tutorial", "destination": "/tutorial.html" },
    { "source": "/tutorials", "destination": "/tutorial.html" },
    { "source": "/tutorial/(.*)", "destination": "/tutorial.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/(.*)", "destination": "/admin.html" }
  ]
}
